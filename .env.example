# Copy to .env (never commit .env) and adjust. All values are optional unless stated.

# --- Engine ---------------------------------------------------------------
# ltspice | ngspice | mock      (mock = SYNTHETIC demo data; also needs ALLOW_MOCK_ENGINE=1)
ENGINE=ngspice
# Required for ENGINE=ltspice. Examples:
#   macOS   : /Applications/LTspice.app/Contents/MacOS/LTspice
#   Windows : "C:\Program Files\ADI\LTspice\LTspice.exe"
#   Linux   : xvfb-run -a wine /opt/ltspice/LTspice.exe
LTSPICE_CMD=
# Override the arguments placed before the netlist path (default: "-b", or "-Run -b" for Windows/Wine).
LTSPICE_ARGS=
NGSPICE_CMD=ngspice
ALLOW_MOCK_ENGINE=

# --- Service --------------------------------------------------------------
DATA_DIR=./data
HOST=0.0.0.0
PORT=8000
# If set, every /api/* call needs the header  X-API-Key: <value>  (or Authorization: Bearer <value>).
API_KEY=
LOG_LEVEL=INFO
LOG_FORMAT=text            # text | json

# --- Limits ---------------------------------------------------------------
MAX_NETLIST_KB=1024
MAX_MODEL_MB=20
MAX_FILES=12
MAX_TOTAL_UPLOAD_MB=60
QUEUE_MAX=200
RATE_LIMIT_PER_MIN=60      # per client IP, per API process; 0 disables
SIM_TIMEOUT_S=300          # one simulator run
JOB_TIMEOUT_S=3600         # whole job
SIM_PARALLELISM=1          # simulator runs in parallel inside one job (keep 1 for LTspice)
MAX_TIME_POINTS=3000000    # refuse runs with more time steps than this
RETENTION_DAYS=30          # used by `buck-sim cleanup`
# Comma-separated LTspice built-in libraries that netlists may reference (LTspice engine only).
# ALLOWED_BUILTIN_LIBS=standard.dio,standard.mos,LTC.lib
